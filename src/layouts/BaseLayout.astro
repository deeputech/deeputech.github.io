---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import ThemeScript from "~/components/ThemeScript.astro";
import SearchDialog from "~/components/SearchDialog.astro";
import { SITE } from "~/data/site";
import {
  breadcrumbNode,
  identityNodes,
  pageNode,
  type Crumb,
  type JsonLd,
} from "~/lib/schema";

export type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  type?: "website" | "article";
  monetization?: boolean;
  noindex?: boolean;
  // Page-level typing for the WebPage node in the JSON-LD graph.
  pageType?: "WebPage" | "ProfilePage" | "AboutPage" | "CollectionPage";
  breadcrumbs?: Crumb[];
  // Extra nodes: the main entity of the page, and any sibling nodes to emit.
  mainEntity?: JsonLd;
  schema?: JsonLd[];
  // Article-specific (filled in by PostLayout)
  publishedTime?: Date;
  modifiedTime?: Date;
  authorName?: string;
  authorUrl?: string;
  tags?: string[];
};

const SITE_NAME = SITE.name;
const SITE_URL = SITE.url;
const SITE_LOGO = SITE.logo;
const SITE_LOCALE = SITE.locale;
const GA_ID = "G-1SDSM5NX07";

// Only emit GA in production builds — keeps dev/preview free of analytics.
const isProd = import.meta.env.PROD;

const {
  title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  canonical,
  type = "website",
  monetization = false,
  noindex = false,
  publishedTime,
  modifiedTime,
  authorName,
  authorUrl,
  tags = [],
  pageType = "WebPage",
  breadcrumbs = [],
  mainEntity,
  schema = [],
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const pageUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const canonicalUrl = canonical ?? pageUrl;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : new URL(ogImage, SITE_URL).toString();
// Posts with a real cover image get the large twitter card, everything else
// falls back to the branded 1200x630 default.
const isLargeCard = ogImage !== SITE_LOGO;

// One graph on every page: site + publisher + author identity, the page itself,
// the article or collection it documents, and breadcrumbs. Entities with an
// @id are emitted as top-level nodes and referenced from the page, which naive
// extractors handle better than deep nesting.
const extras: JsonLd[] = [...schema];
let pageMainEntity = mainEntity;
if (mainEntity && typeof mainEntity["@id"] === "string") {
  pageMainEntity = { "@id": mainEntity["@id"] };
  extras.unshift(mainEntity);
}

const graph: JsonLd[] = [
  ...identityNodes(),
  // The WebPage node describes this copy of the page, even when a cross-posted
  // article's canonical points at another site.
  pageNode({
    url: pageUrl,
    name: title ?? SITE_NAME,
    description,
    image: isLargeCard ? ogImageUrl : undefined,
    pageType,
    mainEntity: pageMainEntity,
    dateModified: modifiedTime,
  }),
];
if (breadcrumbs.length > 0) graph.push(breadcrumbNode(breadcrumbs));
graph.push(...extras);

const ldJson = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/assets/images/logo.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#eff1f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#24273a" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />

    {
      type === "article" && (
        <>
          {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
          {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
          {authorName && <meta name="author" content={authorName} />}
          {authorUrl && <meta property="article:author" content={authorUrl} />}
          {tags.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }

    <meta name="twitter:card" content={isLargeCard ? "summary_large_image" : "summary"} />
    <meta name="twitter:site" content="@deepu105" />
    <meta name="twitter:creator" content="@deepu105" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS feed`} href="/feed.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(ldJson)} />

    {monetization && <meta name="monetization" content="$ilp.uphold.com/Aw7eGpxKNyK7" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Lexend:wght@500;600;700&display=swap"
    />

    <ThemeScript />

    {
      isProd && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID }}>
            {`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', {
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  ad_storage: 'denied',
  analytics_storage: 'granted'
});
gtag('js', new Date());
gtag('config', GA_ID);`}
          </script>
        </>
      )
    }

    <slot name="head" />
  </head>
  <body>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
  </body>
</html>

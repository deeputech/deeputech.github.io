---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import ThemeScript from "~/components/ThemeScript.astro";
import SearchDialog from "~/components/SearchDialog.astro";

export type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  type?: "website" | "article";
  monetization?: boolean;
  noindex?: boolean;
};

const SITE_NAME = "Technorage";
const SITE_TAGLINE = "Where I rant about technology and stuff!";
const SITE_URL = "https://deepu.tech";

const {
  title,
  description = SITE_TAGLINE,
  ogImage = "/assets/images/logo.png",
  canonical,
  type = "website",
  monetization = false,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageUrl = ogImage.startsWith("http") ? ogImage : new URL(ogImage, SITE_URL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/assets/images/logo.png" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@deepu105" />
    <meta name="twitter:creator" content="@deepu105" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {monetization && <meta name="monetization" content="$ilp.uphold.com/Aw7eGpxKNyK7" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Lexend:wght@500;600;700&display=swap"
    />

    <ThemeScript />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
  </body>
</html>

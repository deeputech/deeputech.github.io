---
import BaseLayout from "~/layouts/BaseLayout.astro";
import type { Crumb, JsonLd } from "~/lib/schema";

export type Props = {
  title: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
  pageType?: "WebPage" | "ProfilePage" | "AboutPage" | "CollectionPage";
  breadcrumbs?: Crumb[];
  mainEntity?: JsonLd;
  schema?: JsonLd[];
};

// MDX pages pass frontmatter via the `frontmatter` prop; .astro callers pass title directly.
const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title ?? "";
const description = Astro.props.description ?? fm.description;
---

<BaseLayout
  title={title}
  description={description}
  pageType={Astro.props.pageType}
  breadcrumbs={Astro.props.breadcrumbs}
  mainEntity={Astro.props.mainEntity}
  schema={Astro.props.schema}
>
  <article class="mx-auto max-w-3xl px-4 pt-12 pb-16 sm:px-6 sm:pt-16">
    <header class="mb-10">
      <h1 class="font-display text-4xl font-bold tracking-tight text-[var(--color-fg)] sm:text-5xl">
        {title}
      </h1>
      {description && <p class="mt-3 text-lg text-[var(--color-fg-muted)]">{description}</p>}
    </header>
    <div class="prose-blog">
      <slot />
    </div>
  </article>
</BaseLayout>

---
import { defaultAuthor } from "~/data/authors";

export type Props = {
  size?: "sm" | "md";
  showLabels?: boolean;
};

const { size = "md", showLabels = true } = Astro.props;
const author = defaultAuthor;

const links = [
  { href: author.bsky!, label: "BlueSky", icon: "bluesky" },
  { href: author.mastodon, label: "Mastodon", icon: "mastodon" },
  { href: author.github!, label: "GitHub", icon: "github" },
  { href: author.linkedin!, label: "LinkedIn", icon: "linkedin" },
  { href: author.twitter, label: "Twitter / X", icon: "twitter" },
  { href: "https://dev.to/deepu105", label: "Dev.to", icon: "devto" },
  { href: "https://speakerdeck.com/deepu105", label: "SpeakerDeck", icon: "speakerdeck" },
];

const sz = size === "sm" ? "h-4 w-4" : "h-5 w-5";
---

<div class="flex flex-wrap items-center gap-2">
  {
    links.map((l) => (
      <a
        href={l.href}
        target="_blank"
        rel="noopener noreferrer me"
        title={l.label}
        aria-label={l.label}
        class:list={[
          "group inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] text-[var(--color-fg-muted)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-fg)]",
          showLabels ? "px-3 py-1.5 text-sm" : "h-9 w-9 justify-center",
        ]}
      >
        <svg class={sz} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          {l.icon === "bluesky" && (
            <path d="M12 10.8C10.8 8.4 8.5 5 6 4c-2.7-1.1-3.7.5-3.7 1.6 0 1.1.5 8.6.9 9.8.9 2.7 3.7 3.4 6 2.9-3.4.6-6.4 1.7-2.5 6.1 4.3 4.5 5.9-1 6.7-3.7.8 2.7 1.7 8 6.4 3.7 4.4-4.4 1.6-5.5-1.8-6.1 2.4.5 5.2-.2 6.1-2.9.4-1.2.9-8.7.9-9.8 0-1.2-1-2.7-3.7-1.6-2.5 1-4.8 4.4-6 6.8z" />
          )}
          {l.icon === "mastodon" && (

---
import { Icon } from "astro-icon/components";
import { defaultAuthor } from "~/data/authors";

export type Props = {
  size?: "sm" | "md";
  showLabels?: boolean;
};

const { size = "md", showLabels = true } = Astro.props;
const author = defaultAuthor;

const links = [
  { href: author.github!, label: "GitHub", icon: "simple-icons:github" },
  { href: author.linkedin!, label: "LinkedIn", icon: "simple-icons:linkedin" },
  { href: author.bsky!, label: "BlueSky", icon: "simple-icons:bluesky" },
  { href: author.mastodon, label: "Mastodon", icon: "simple-icons:mastodon" },
  { href: author.twitter, label: "Twitter", icon: "simple-icons:x" },
  { href: "https://dev.to/deepu105", label: "Dev.to", icon: "simple-icons:devdotto" },
  { href: "https://speakerdeck.com/deepu105", label: "SpeakerDeck", icon: "simple-icons:speakerdeck" },
];

const sz = size === "sm" ? "h-4 w-4" : "h-5 w-5";
---

<div class="flex flex-wrap items-center gap-2">
  {
    links.map((l) => (
      <a
        href={l.href}
        target="_blank"
        rel="noopener noreferrer me"
        title={l.label}
        aria-label={l.label}
        class:list={[
          "group inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] text-[var(--color-fg-muted)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-fg)]",
          showLabels ? "px-3 py-1.5 text-sm" : "h-9 w-9 justify-center",
        ]}
      >
        <Icon name={l.icon} class={sz} />
        {showLabels && <span>{l.label}</span>}
      </a>
    ))
  }
</div>

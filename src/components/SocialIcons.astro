            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          )}
          {l.icon === "devto" && (
            <path d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6l.02 2.44.04 2.45.56-.02c.41 0 .63-.07.83-.26.24-.24.26-.36.26-2.2 0-1.93-.02-1.96-.29-2.18zM0 4.94v14.13h24V4.94H0zm8.56 9.93c-.32.85-1.31 1.4-2.12 1.4H4.55V8.43h1.94c.81 0 1.81.55 2.13 1.4.16.43.16.55.16 2.51 0 1.97 0 2.09-.22 2.53zm5.52-5.4H11.5v1.62h1.62v1.45H11.5v1.62h2.58v1.45H10.4c-.26-.07-.45-.21-.62-.42-.16-.21-.21-.36-.21-.71v-5.97c0-.34.05-.5.21-.71.17-.21.36-.35.62-.42h3.68v1.45zm6 6.2c-.65.5-1.5.42-1.92-.16-.6-.84-2.13-7.91-2.06-7.97.06-.06.41-.11.79-.13.51-.02.7.04.73.21.05.13.36 1.62.7 3.31.34 1.69.69 2.97.79 2.83.07-.08.34-1.5.62-3.16.27-1.66.51-3.04.55-3.07.04-.04.4-.07.81-.07.61 0 .73.04.7.21-.03.13-.55 2.44-1.16 5.13-1.07 4.78-1.13 4.93-1.55 4.87z" />
          )}
          {l.icon === "speakerdeck" && (
            <path d="M10.025 13.875H4.715A4.717 4.717 0 0 1 0 9.16C0 6.557 2.114 4.443 4.717 4.443h6.74a2.86 2.86 0 0 1 2.86 2.86 2.86 2.86 0 0 1-2.86 2.86h-2.764a.717.717 0 0 0 0 1.434h1.332zm5.31-9.432c2.604 0 4.715 2.115 4.715 4.717a4.715 4.715 0 0 1-4.715 4.717H10.83a2.86 2.86 0 1 1 0-5.717h2.625a.717.717 0 0 0 0-1.434h-3.43V4.443z" />
          )}
        </svg>
        {showLabels && <span>{l.label}</span>}
      </a>
    ))
  }
</div>

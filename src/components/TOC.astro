---
import type { MarkdownHeading } from "astro";

export type Props = {
  headings: MarkdownHeading[];
};

// Only render h2/h3 — h1 is the post title, h4+ is too noisy in a sidebar.
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav class="toc text-sm" aria-label="Table of contents">
      <p class="font-display mb-3 text-xs font-semibold tracking-wider text-[var(--color-fg-subtle)] uppercase">
        On this page
      </p>
      <ul class="space-y-1.5">
        {items.map((h) => (
          <li class={h.depth === 3 ? "pl-4" : ""}>
            <a
              href={`#${h.slug}`}
              data-toc-target={h.slug}
              class="toc-link block border-l-2 border-transparent py-0.5 pl-3 leading-snug text-[var(--color-fg-muted)] transition hover:border-[var(--color-border-strong)] hover:text-[var(--color-fg)]"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc-link[data-active="true"] {
    color: var(--color-accent);
    border-color: var(--color-accent);
    font-weight: 500;
  }
</style>

<script is:inline>
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll(".toc-link"));
    if (!links.length) return;
    var bySlug = {};
    links.forEach(function (l) {
      bySlug[l.getAttribute("data-toc-target")] = l;
    });
    var headings = Object.keys(bySlug)
      .map(function (slug) {
        return document.getElementById(slug);
      })
      .filter(Boolean);
    if (!headings.length) return;

    var current = null;
    var observer = new IntersectionObserver(
      function (entries) {
        // Find the topmost intersecting heading.
        var visible = entries
          .filter(function (e) {
            return e.isIntersecting;
          })
          .sort(function (a, b) {
            return a.boundingClientRect.top - b.boundingClientRect.top;
          });
        if (visible.length) {
          var newCurrent = visible[0].target.id;
          if (newCurrent !== current) {
            if (current && bySlug[current]) bySlug[current].removeAttribute("data-active");
            current = newCurrent;
            if (bySlug[current]) bySlug[current].setAttribute("data-active", "true");
          }
        }
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );
    headings.forEach(function (h) {
      observer.observe(h);
    });
  })();
</script>

---
export type Props = {
  href: string;
  title?: string;
  description?: string;
};

const { href, title, description } = Astro.props;
const display = title ?? href;
let host = "";
try {
  host = new URL(href).host.replace(/^www\./, "");
} catch (_) {
  host = "";
}
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="not-prose my-6 block rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4 transition hover:border-[var(--color-border-strong)]"
>
  <div class="flex items-center gap-2 text-xs text-[var(--color-fg-subtle)]">
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.72-1.71"></path>
    </svg>
    {host && <span>{host}</span>}
  </div>
  <h3 class="mt-1 text-base font-semibold text-[var(--color-fg)]">{display}</h3>
  {description && <p class="mt-1 text-sm text-[var(--color-fg-muted)]">{description}</p>}
</a>

---
import { getCollection } from "astro:content";

export type Props = {
  href: string;
  title?: string;
  description?: string;
};

const { href, title, description } = Astro.props;

// Direct port of the original `link_tag.rb` + `pre_render_hook.rb` behaviour:
// for any `{% link <url> %}` (now <LinkCard href={url} />), if the URL points
// at a post on this blog OR a Dev.to URL that maps to one (via devto_url
// front-matter), render a rich card with title/date/tags. Otherwise show a
// plain external bookmark.
const allPosts = await getCollection("posts");

function findInternalPost(url: string) {
  const normalized = url.replace(/\/$/, "").trim();
  // 1. canonical_url match (deepu.tech/<slug>/)
  let match = allPosts.find((p) => {
    const c = p.data.canonical_url?.replace(/\/$/, "");
    return c && c === normalized;
  });
  if (match) return match;
  // 2. devto_url match (dev.to/<user>/<slug>) — what the metadata cache + pre-
  //    render hook resolved at Jekyll build time.
  match = allPosts.find((p) => {
    const d = p.data.devto_url?.replace(/\/$/, "");
    return d && d === normalized;
  });
  if (match) return match;
  // 3. /<slug>/ on deepu.tech (when canonical_url is unset)
  if (/^https?:\/\/(?:www\.)?deepu\.tech\//i.test(url)) {
    const slug = new URL(url).pathname.replace(/^\/|\/$/g, "");
    match = allPosts.find((p) => p.id === slug);
    if (match) return match;
  }
  return null;
}

const internal = findInternalPost(href);
let host = "";
try {
  host = new URL(href).host.replace(/^www\./, "");
} catch (_) {
  host = "";
}

const dateStr = internal
  ? internal.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
  : null;
---

{
  internal ? (
    <a
      href={`/${internal.id}/`}
      class="not-prose group my-6 block rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 transition hover:border-[var(--color-accent)]"
    >
      <div class="flex items-center gap-2 text-xs text-[var(--color-fg-subtle)]">
        <svg
          class="h-3.5 w-3.5 text-[var(--color-accent)]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
        <span>From the blog · {dateStr}</span>
      </div>
      <h3 class="font-display mt-2 text-lg leading-snug font-semibold text-[var(--color-fg)] group-hover:text-[var(--color-accent)]">
        {internal.data.title}
      </h3>
      {internal.data.description && (
        <p class="mt-1 line-clamp-2 text-sm text-[var(--color-fg-muted)]">
          {internal.data.description}
        </p>
      )}
      {internal.data.tags && internal.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5 text-xs text-[var(--color-fg-subtle)]">
          {internal.data.tags.slice(0, 5).map((t) => (
            <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5">#{t}</span>
          ))}
        </div>
      )}
    </a>
  ) : (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="not-prose group my-6 block rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 transition hover:border-[var(--color-border-strong)]"
    >
      <div class="flex items-center gap-2 text-xs text-[var(--color-fg-subtle)]">
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.72-1.71"></path>
        </svg>
        {host && <span>{host}</span>}
      </div>
      <h3 class="mt-1 text-base font-semibold text-[var(--color-fg)]">{title ?? href}</h3>
      {description && <p class="mt-1 text-sm text-[var(--color-fg-muted)]">{description}</p>}
    </a>
  )
}

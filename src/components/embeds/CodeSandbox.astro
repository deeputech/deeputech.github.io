---
export type Props = {
  id: string;
  height?: number;
  fontsize?: number;
};

const { id, height = 500, fontsize = 14 } = Astro.props;
---

<div class="my-6 overflow-hidden rounded-lg border border-[var(--color-border)]">
  <iframe
    src={`https://codesandbox.io/embed/${id}?fontsize=${fontsize}`}
    style={`width:100%; height:${height}px; border:0;`}
    sandbox="allow-modals allow-forms allow-popups allow-scripts allow-same-origin"
    loading="lazy"
    title={`CodeSandbox: ${id}`}
  ></iframe>
</div>

---
import type { Post } from "~/lib/posts";

export type Props = {
  post: Post;
  /**
   * - "card"    : image on top + content below (vertical card)
   * - "row"     : image as left column + content as right column (horizontal)
   * - "compact" : title + description only, no image (dense list)
   */
  variant?: "card" | "row" | "compact";
};

const { post, variant = "card" } = Astro.props;
const url = `/${post.id}/`;
const dateStr = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const coverSrc = post.data.cover_image
  ? post.data.cover_image.startsWith("http") || post.data.cover_image.startsWith("/")
    ? post.data.cover_image
    : `/${post.data.cover_image}`
  : null;
---

{
  variant === "compact" ? (
    <a
      href={url}
      class="not-prose group block border-b border-[var(--color-border)] py-5 transition hover:border-[var(--color-border-strong)]"
    >
      <div class="flex items-baseline gap-3 text-xs text-[var(--color-fg-subtle)]">
        <time datetime={post.data.date.toISOString()}>{dateStr}</time>
        {post.data.series && (
          <>
            <span>·</span>
            <span>{post.data.series}</span>
          </>
        )}
      </div>
      <h3 class="font-display mt-1 text-lg leading-snug font-semibold text-[var(--color-fg)] group-hover:text-[var(--color-accent)] sm:text-xl">
        {post.data.title}
      </h3>
      {post.data.description && (
        <p class="mt-1 line-clamp-2 text-sm text-[var(--color-fg-muted)]">
          {post.data.description}
        </p>
      )}
    </a>
  ) : variant === "card" ? (
    <a href={url} class="not-prose group block h-full overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] transition hover:border-[var(--color-border-strong)]">
      {coverSrc && (
        <div class="aspect-[16/9] w-full overflow-hidden bg-[var(--color-bg-muted)]">
          <img
            src={coverSrc}
            alt={post.data.title}
            loading="lazy"
            class="h-full w-full object-cover transition group-hover:scale-105"
          />
        </div>
      )}
      <div class="p-3.5">
        <div class="flex items-center gap-2 text-[11px] text-[var(--color-fg-subtle)]">
          <time datetime={post.data.date.toISOString()}>{dateStr}</time>
        </div>
        <h3 class="font-display mt-1.5 text-sm leading-snug font-semibold text-[var(--color-fg)] group-hover:text-[var(--color-accent)]">
          {post.data.title}
        </h3>
        {post.data.description && (
          <p class="mt-3 line-clamp-3 text-xs text-[var(--color-fg-muted)]">
            {post.data.description}
          </p>
        )}
      </div>
    </a>
  ) : (
    <a
      href={url}
      class="not-prose group grid grid-cols-[7rem_1fr] gap-4 border-b border-[var(--color-border)] py-5 transition hover:border-[var(--color-border-strong)] sm:grid-cols-[10rem_1fr] sm:gap-6"
    >
      <div class="aspect-[16/10] w-full overflow-hidden rounded-lg bg-[var(--color-bg-muted)]">
        {coverSrc ? (
          <img
            src={coverSrc}
            alt={post.data.title}
            loading="lazy"
            class="h-full w-full object-cover transition group-hover:scale-105"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center text-[var(--color-fg-subtle)]">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"></path>
            </svg>
          </div>
        )}
      </div>
      <div class="min-w-0">
        <div class="flex items-baseline gap-3 text-xs text-[var(--color-fg-subtle)]">
          <time datetime={post.data.date.toISOString()}>{dateStr}</time>
          {post.data.series && (
            <>
              <span>·</span>
              <span class="truncate">{post.data.series}</span>
            </>
          )}
        </div>
        <h3 class="font-display mt-1 text-lg leading-snug font-semibold text-[var(--color-fg)] group-hover:text-[var(--color-accent)] sm:text-xl">
          {post.data.title}
        </h3>
        {post.data.description && (
          <p class="mt-1 line-clamp-2 text-sm text-[var(--color-fg-muted)]">
            {post.data.description}
          </p>
        )}
      </div>
    </a>
  )
}

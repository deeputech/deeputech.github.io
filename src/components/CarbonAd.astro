---
// Carbon Ads embed. The placement & serve IDs are tied to deeputech's
// CarbonAds account. To disable, remove the script tag; to swap, change
// the serve= and placement= query params.
---

<div class="carbon-ad my-6">
  <script
    is:inline
    async
    type="text/javascript"
    src="//cdn.carbonads.com/carbon.js?serve=CE7ITK3I&placement=deeputech"
    id="_carbonads_js"></script>
</div>

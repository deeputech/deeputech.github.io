---
import BaseLayout from "~/layouts/BaseLayout.astro";

type Tool = {
  href: string;
  title: string;
  description: string;
  /** External projects open in a new tab and show their host. */
  external?: boolean;
};

const tools: Tool[] = [
  {
    href: "/tools/asciinema-editor/",
    title: "Asciinema Editor",
    description:
      "Trim, speed up, quantize idle gaps, drop events, and add markers in asciicast (.cast) recordings. Loads and saves v2 and v3. Everything runs in your browser — nothing is uploaded.",
  },
  {
    href: "https://llamastash.dev",
    title: "LlamaStash",
    description:
      "Zero-overhead, terminal-native launcher for local LLMs on top of llama.cpp. Pull GGUF models and serve them behind an OpenAI-compatible proxy for your coding agents.",
    external: true,
  },
  {
    href: "https://github.com/kdash-rs/kdash",
    title: "KDash",
    description:
      "A fast and simple terminal dashboard for Kubernetes — monitor contexts, nodes, pods, logs, and more, all from the keyboard.",
    external: true,
  },
  {
    href: "https://github.com/jwt-rs/jwt-ui",
    title: "JWT UI",
    description:
      "A terminal UI for decoding and encoding JSON Web Tokens, inspired by jwt.io and jwt-cli.",
    external: true,
  },
  {
    href: "https://start.jhipster.tech/jdl-studio/",
    title: "JDL Studio",
    description:
      "Online editor for the JHipster Domain Language (JDL). Design your entities and relationships visually, then export the JDL.",
    external: true,
  },
];

const hostOf = (url: string) => {
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return "";
  }
};
---

<BaseLayout
  title="Tools"
  description="Tools and open-source projects by Deepu K Sasidharan."
>
  <div class="mx-auto max-w-3xl px-4 pt-12 pb-16 sm:px-6">
    <header class="mb-10">
      <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Tools</h1>
      <p class="mt-3 text-lg text-[var(--color-fg-muted)]">
        Tools and open-source projects I build and maintain. Some run right here in your browser;
        others live in their own home.
      </p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <a
            href={tool.href}
            target={tool.external ? "_blank" : undefined}
            rel={tool.external ? "noopener noreferrer" : undefined}
            class="group flex flex-col rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 transition hover:border-[var(--color-border-strong)]"
          >
            <div class="flex items-center gap-2">
              <h2 class="font-display text-xl font-semibold tracking-tight text-[var(--color-fg)] group-hover:text-[var(--color-accent)]">
                {tool.title}
              </h2>
              {tool.external && (
                <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 font-mono text-[10px] text-[var(--color-fg-subtle)]">
                  {hostOf(tool.href)}
                </span>
              )}
            </div>
            <p class="mt-2 flex-1 text-sm text-[var(--color-fg-muted)]">{tool.description}</p>
            <span class="mt-4 text-sm font-medium text-[var(--color-accent)]">
              {tool.external ? "Visit ↗" : "Open tool →"}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

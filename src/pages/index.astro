---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostCard from "~/components/PostCard.astro";
import { defaultAuthor } from "~/data/authors";
import { getPublishedPosts, getFeaturedPosts, getAllSeries } from "~/lib/posts";
import { Content as Talks } from "~/data/talks.mdx";

const author = defaultAuthor;
const all = await getPublishedPosts();
const latest = all.slice(0, 5);
const featured = (await getFeaturedPosts()).slice(0, 4);
const seriesGroups = await getAllSeries();
const topSeries = seriesGroups
  .filter((s) => s.count >= 2)
  .sort((a, b) => b.count - a.count)
  .slice(0, 4);

const projects = [
  { name: "JHipster", href: "https://jhipster.tech/", note: "Rapid app development for modern Java + JS." },
  { name: "KDash", href: "https://github.com/kdash-rs/kdash", note: "A Kubernetes dashboard, in Rust." },
  { name: "JWT UI", href: "https://github.com/jwt-rs/jwt-ui", note: "Terminal UI for decoding JWTs." },
  { name: "JDL Studio", href: "https://start.jhipster.tech/jdl-studio/", note: "Online editor for the JHipster Domain Language." },
];

const social = [
  { href: author.bsky!, label: "BlueSky" },
  { href: author.mastodon, label: "Mastodon" },
  { href: author.github!, label: "GitHub" },
  { href: author.linkedin!, label: "LinkedIn" },
  { href: author.twitter, label: "Twitter" },
  { href: "https://dev.to/deepu105", label: "Dev.to" },
  { href: "https://speakerdeck.com/deepu105", label: "SpeakerDeck" },
];
---

<BaseLayout
  title="Deepu K Sasidharan"
  description="Java Champion, Co-chair of JHipster, polyglot developer. I write about Rust, Go, Java, developer experience and cloud-native."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-12 sm:px-6 sm:pt-24">
    <p class="mb-3 text-sm font-medium tracking-wider text-[var(--color-accent)] uppercase">
      Hi, I'm Deepu 👋
    </p>
    <h1 class="font-display text-4xl leading-tight font-bold tracking-tight text-[var(--color-fg)] sm:text-6xl">
      I build, I write, I rant about technology.
    </h1>
    <p class="mt-6 text-lg text-[var(--color-fg-muted)]">
      Java Champion · Co-chair of <a href="https://jhipster.tech">JHipster</a> · Creator of
      <a href="https://github.com/kdash-rs/kdash">KDash</a> &amp;
      <a href="https://github.com/jwt-rs/jwt-ui">JWT UI</a>. Polyglot developer working with Rust,
      Go, Java, JavaScript, TypeScript and Kotlin. Staff Developer Advocate at Auth0 by Okta.
      I love Linux, motorbikes, astronomy, and good developer experience.
    </p>

    <div class="mt-8 flex flex-wrap gap-2 text-sm">
      {
        social.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer me"
            class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-3 py-1.5 text-[var(--color-fg-muted)] transition hover:border-[var(--color-border-strong)] hover:text-[var(--color-fg)]"
          >
            {s.label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <header class="mb-6 flex items-baseline justify-between">
      <h2 class="font-display text-xs font-semibold tracking-wider text-[var(--color-fg-subtle)] uppercase">Latest writing</h2>
      <a href="/blogs/" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">All posts →</a>
    </header>
    <div>
      {latest.map((p) => <PostCard post={p} variant="row" />)}
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
        <h2 class="font-display mb-6 text-xs font-semibold tracking-wider text-[var(--color-fg-subtle)] uppercase">Featured</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {featured.map((p) => (
            <PostCard post={p} variant="card" />
          ))}
        </div>
      </section>
    )
  }

  {
    topSeries.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
        <header class="mb-6 flex items-baseline justify-between">
          <h2 class="font-display text-xs font-semibold tracking-wider text-[var(--color-fg-subtle)] uppercase">Deep-dive series</h2>
          <a href="/series/" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">All series →</a>
        </header>
        <ul class="grid gap-3 sm:grid-cols-2">
          {topSeries.map((s) => (
            <li>
              <a
                href={`/series/${s.series.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}/`}
                class="block rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4 transition hover:border-[var(--color-border-strong)]"
              >
                <span class="font-display block text-base font-semibold text-[var(--color-fg)]">{s.series}</span>
                <span class="text-xs text-[var(--color-fg-subtle)]">{s.count} posts</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <h2 class="font-display mb-6 text-xs font-semibold tracking-wider text-[var(--color-fg-subtle)] uppercase">Open-source projects</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((p) => (
          <a
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group block rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4 transition hover:border-[var(--color-border-strong)]"
          >
            <span class="font-display block text-base font-semibold text-[var(--color-fg)] group-hover:text-[var(--color-accent)]">{p.name}</span>
            <span class="mt-1 block text-sm text-[var(--color-fg-muted)]">{p.note}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-20 sm:px-6">
    <header class="mb-4 flex items-baseline justify-between">
      <h2 class="font-display text-xs font-semibold tracking-wider text-[var(--color-fg-subtle)] uppercase">Upcoming events</h2>
      <a href="/appearances/" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">All events →</a>
    </header>
    <div class="prose-blog">
      <Talks />
    </div>
  </section>
</BaseLayout>

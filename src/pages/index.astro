---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { defaultAuthor } from "~/data/authors";

const author = defaultAuthor;

const social = [
  { href: author.bsky!, label: "BlueSky", icon: "bsky" },
  { href: author.mastodon, label: "Mastodon", icon: "mastodon" },
  { href: author.github!, label: "GitHub", icon: "github" },
  { href: author.linkedin!, label: "LinkedIn", icon: "linkedin" },
  { href: author.twitter, label: "Twitter", icon: "twitter" },
];
---

<BaseLayout
  title="Deepu K Sasidharan"
  description="Java Champion, Co-chair of JHipster, polyglot developer. I write about Rust, Go, Java, developer experience, and cloud-native."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-10 sm:px-6 sm:pt-24">
    <p class="mb-3 text-sm font-medium tracking-wider text-[var(--color-accent)] uppercase">
      Hi, I'm Deepu 👋
    </p>
    <h1 class="font-display text-4xl leading-tight font-bold tracking-tight text-[var(--color-fg)] sm:text-6xl">
      I build, I write, I rant about technology.
    </h1>
    <p class="mt-6 text-lg text-[var(--color-fg-muted)]">
      Java Champion · Co-chair of <a href="https://jhipster.tech">JHipster</a> · Creator of
      <a href="https://github.com/kdash-rs/kdash">KDash</a> &
      <a href="https://github.com/jwt-rs/jwt-ui">JWT UI</a>. Polyglot developer working with Rust,
      Go, Java, JavaScript, TypeScript and Kotlin.
    </p>

    <div class="mt-8 flex flex-wrap gap-3 text-sm">
      {
        social.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-3 py-1.5 text-[var(--color-fg-muted)] transition hover:border-[var(--color-border-strong)] hover:text-[var(--color-fg)]"
          >
            {s.label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-20 sm:px-6">
    <p class="text-sm text-[var(--color-fg-subtle)]">
      <em>Homepage in progress — full version lands in Phase 3.</em>
      <a href="/preview-typography/" class="underline-offset-2 hover:underline">View typography test →</a>
    </p>
  </section>
</BaseLayout>

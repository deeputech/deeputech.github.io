---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostCard from "~/components/PostCard.astro";
import IconLinkCard from "~/components/IconLinkCard.astro";
import SocialIcons from "~/components/SocialIcons.astro";
import { appNode, itemListNode } from "~/lib/schema";
import { getPublishedPosts, getFeaturedPosts, getAllSeries, slugifySeries } from "~/lib/posts";
import { Content as Talks } from "~/data/talks.mdx";

const all = await getPublishedPosts();
const latest = all.slice(0, 4);
const featured = (await getFeaturedPosts()).slice(0, 6);
const seriesGroups = await getAllSeries();
const topSeries = seriesGroups
  .filter((s) => s.count >= 2)
  .sort((a, b) => b.count - a.count)
  .slice(0, 6);

const projects = [
  {
    name: "LlamaStash",
    href: "https://github.com/llamastash/llamastash",
    note: "Terminal-native local-LLM orchestrator. Run any engine, any model.",
    tags: ["rust", "llamacpp", "localllm", "tui"],
    os: "Any",
    languages: ["Rust"],
  },
  {
    name: "KDash",
    href: "https://github.com/kdash-rs/kdash",
    note: "A Kubernetes dashboard that runs in the terminal.",
    tags: ["rust", "kubernetes", "tui", "monitoring"],
    os: "Any",
    languages: ["Rust"],
  },
  {
    name: "Pi Automode Classifier",
    href: "https://github.com/deepu105/pi-automode-classifier",
    note: "Claude Code like auto mode for Pi, that works with any LLM or classifier including local models.",
    tags: ["ai", "pi", "classifier", "llm"],
    languages: ["TypeScript"],
    os: "Any",
  },
  {
    name: "JHipster",
    href: "https://jhipster.tech/",
    note: "Rapid application development platform for modern Java fullstack applications.",
    tags: ["java", "spring-boot", "angular", "react"],
    languages: ["Java", "TypeScript"],
    os: "Any",
    role: "co-chair" as const,
  },
  {
    name: "JDL Studio",
    href: "https://start.jhipster.tech/jdl-studio/",
    note: "The editor for JDL, the schema language JHipster generates applications from.",
    tags: ["javascript", "react", "jhipster", "dsl"],
    languages: ["TypeScript"],
    os: "Any",
  },
  {
    name: "JWT UI",
    href: "https://github.com/jwt-rs/jwt-ui",
    note: "Decodes and encodes JSON Web Tokens in the terminal",
    tags: ["rust", "jwt", "tui", "cli"],
    languages: ["Rust"],
    os: "Any",
  },
  {
    name: "auth0-token-vault-cli",
    href: "https://github.com/deepu105/auth0-token-vault-cli",
    note: "Lets an agent call Google, GitHub, or Slack through Auth0 Token Vault.",
    tags: ["typescript", "auth0", "oauth", "ai-agents"],
    languages: ["TypeScript"],
    os: "Any",
  },
  {
    name: "Auth0 Assistant0",
    href: "https://github.com/auth0-samples/auth0-assistant0",
    note: "Sample AI assistant that reaches Gmail and Slack over OAuth 2.0 with Auth0.",
    tags: ["typescript", "ai", "auth0", "langchain"],
    languages: ["TypeScript"],
    os: "Any",
  },
];

const sections = [
  { id: "about", label: "About" },
  { id: "projects", label: "Projects" },
  { id: "writing", label: "Latest writing" },
  { id: "featured", label: "Featured" },
  { id: "series", label: "Series" },
  { id: "bio", label: "Bio" },
  { id: "events", label: "Events" },
];
---

<BaseLayout
  title="Deepu K Sasidharan"
  description="Rust terminal tools (LlamaStash, KDash, JWT UI), JHipster co-chair, and posts on local LLMs, Java, Kubernetes, Linux, and OAuth. By Deepu K Sasidharan."
  pageType="ProfilePage"
  schema={[itemListNode(projects.map((p) => appNode({ name: p.name, url: p.href, description: p.note, languages: p.languages, os: p.os, role: p.role })), "Open-source projects by Deepu K Sasidharan")]}
>
  <div class="mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_180px]">
      <div>
        <!-- Hero -->
        <section id="about" class="scroll-mt-24">
          <p class="font-display mb-4 text-2xl font-semibold text-[var(--color-accent)] sm:text-3xl">Hi, I'm Deepu K Sasidharan 👋</p>
          <p class="mt-6 text-lg text-[var(--color-fg-muted)]">
            <strong>Polyglot developer</strong> · Local AI tinkerer · Creator of
            <a href="https://github.com/llamastash/llamastash">LlamaStash</a>,
            <a href="https://github.com/kdash-rs/kdash">KDash</a> and
            <a href="https://start.jhipster.tech/jdl-studio/">JDL Studio</a> · Co-chair of
            <a href="https://jhipster.tech">JHipster</a> · Linux enthusiast · Java Champion · Published author · International speaker
          </p>

          <div class="mt-6">
            <SocialIcons size="sm" showLabels={true} />
          </div>
        </section>

        <!-- Projects -->
        <section id="projects" class="mt-20 scroll-mt-24">
          <header class="mb-6 flex items-baseline justify-between">
            <h2 class="font-display text-2xl font-bold tracking-tight">Open-source projects</h2>
          </header>
          <div class="grid gap-4 sm:grid-cols-2">
            {projects.map((p) => <IconLinkCard href={p.href} title={p.name} subtitle={p.note} tags={p.tags} external />)}
          </div>
        </section>

        <!-- Latest writing -->
        <section id="writing" class="mt-20 scroll-mt-24">
          <header class="mb-6 flex items-baseline justify-between">
            <h2 class="font-display text-2xl font-bold tracking-tight">Latest writing</h2>
            <a href="/blogs/" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">All posts →</a>
          </header>
          <div>
            {latest.map((p) => <PostCard post={p} variant="row" />)}
          </div>
          <div class="mt-6">
            <IconLinkCard
              href="https://auth0.com/blog/authors/deepu-sasidharan/"
              title="Also on the Auth0 blog"
              subtitle="My professional articles on identity, AI agents, and developer experience at Auth0 / Okta."
              external
            />
          </div>
        </section>

        <!-- Bio -->
        <section id="bio" class="mt-20 scroll-mt-24">
          <header class="mb-6 flex items-baseline justify-between">
            <h2 class="font-display text-2xl font-bold tracking-tight">Bio</h2>
            <a href="/cv/" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">Full CV →</a>
          </header>
          <ul class="prose-blog terminal-list space-y-2 text-[var(--color-fg-muted)]">
            <li>
              Principal Developer Advocate at <a href="https://auth0.com">Auth0 (Okta)</a>, covering identity for AI agents. 16+ years in the industry, before that at Adyen, XebiaLabs, and TCS.
            </li>
            <li>
              Creator of <a href="https://github.com/llamastash/llamastash">LlamaStash</a>,
              <a href="https://github.com/kdash-rs/kdash">KDash</a>,
              <a href="https://github.com/jwt-rs/jwt-ui">JWT UI</a>, and
              <a href="https://start.jhipster.tech/jdl-studio/">JDL Studio</a>. Most of it is Rust, most of it runs in a terminal.
            </li>
            <li>
              Co-chair and vice-president of <a href="https://jhipster.tech">JHipster</a>, a core maintainer since 2015.
            </li>
            <li>
              <a href="https://dev.java/community/jcs/">Java Champion</a> and author of
              <em>Full Stack Development with JHipster</em> (Packt, two editions).
            </li>
            <li>
              I run local models for my daily coding setup and write up the benchmarks and the tuning
              that made it usable. See <a href="/tags/#ai">the local AI posts</a>.
            </li>
            <li>80+ conference talks. <a href="/appearances/">Event list</a>.</li>
            <li>Long-time Linux user, currently on Arch with <a href="https://github.com/niri-wm/niri">Niri</a>.</li>
          </ul>
        </section>

        <!-- Featured -->
        {
          featured.length > 0 && (
            <section id="featured" class="mt-20 scroll-mt-24">
              <header class="mb-6 flex items-baseline justify-between">
                <h2 class="font-display text-2xl font-bold tracking-tight">Featured</h2>
              </header>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {featured.map((p) => (
                  <PostCard post={p} variant="card" />
                ))}
              </div>
            </section>
          )
        }

        <!-- Series -->
        {
          topSeries.length > 0 && (
            <section id="series" class="mt-20 scroll-mt-24">
              <header class="mb-6 flex items-baseline justify-between">
                <h2 class="font-display text-2xl font-bold tracking-tight">Deep-dive series</h2>
                <a href="/series/" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">
                  All series →
                </a>
              </header>
              <div class="grid gap-4 sm:grid-cols-2">
                {topSeries.map((s) => (
                  <a
                    href={`/series/${slugifySeries(s.series)}/`}
                    class="group block rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4 transition hover:border-[var(--color-accent)]"
                  >
                    <span class="font-display block text-base font-semibold text-[var(--color-fg)] group-hover:text-[var(--color-accent)]">
                      {s.series}
                    </span>
                    <span class="mt-1 block text-xs text-[var(--color-fg-subtle)]">{s.count} posts</span>
                  </a>
                ))}
              </div>
            </section>
          )
        }



        <!-- Events -->
        <section id="events" class="mt-20 mb-8 scroll-mt-24">
          <header class="mb-4 flex items-baseline justify-between">
            <h2 class="font-display text-2xl font-bold tracking-tight">Upcoming events</h2>
            <a href="/appearances/" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)]">All events →</a>
          </header>
          <div class="prose-blog">
            <Talks />
          </div>
        </section>
      </div>

      <!-- Sticky sidemenu -->
      <aside class="hidden lg:block">
        <nav class="sticky top-24 text-sm" aria-label="Page sections">
          <p class="font-display mb-3 text-xs font-semibold tracking-wider text-[var(--color-fg-subtle)] uppercase">On this page</p>
          <ul class="space-y-1">
            {
              sections.map((s) => (
                <li>
                  <a
                    href={`#${s.id}`}
                    data-section-target={s.id}
                    class="page-nav-link block border-l-2 border-transparent py-1 pl-3 text-[var(--color-fg-muted)] transition hover:border-[var(--color-border-strong)] hover:text-[var(--color-fg)]"
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .page-nav-link[data-active="true"] {
    color: var(--color-accent);
    border-color: var(--color-accent);
    font-weight: 500;
  }
</style>

<script is:inline>
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll(".page-nav-link"));
    if (!links.length) return;
    var bySlug = {};
    links.forEach(function (l) {
      bySlug[l.getAttribute("data-section-target")] = l;
    });
    var sections = Object.keys(bySlug)
      .map(function (s) {
        return document.getElementById(s);
      })
      .filter(Boolean);
    if (!sections.length) return;
    var current = null;
    var observer = new IntersectionObserver(
      function (entries) {
        var visible = entries
          .filter(function (e) {
            return e.isIntersecting;
          })
          .sort(function (a, b) {
            return a.boundingClientRect.top - b.boundingClientRect.top;
          });
        if (visible.length) {
          var n = visible[0].target.id;
          if (n !== current) {
            if (current && bySlug[current]) bySlug[current].removeAttribute("data-active");
            current = n;
            if (bySlug[current]) bySlug[current].setAttribute("data-active", "true");
          }
        }
      },
      { rootMargin: "-100px 0px -60% 0px" },
    );
    sections.forEach(function (s) {
      observer.observe(s);
    });
  })();
</script>

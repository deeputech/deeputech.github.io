---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getAllSeries, slugifySeries } from "~/lib/posts";
import { seriesMeta } from "~/data/series";

const seriesGroups = await getAllSeries();
const meta: Record<string, string> = {};
for (const s of seriesMeta) meta[s.id] = s.description;
---

<BaseLayout title="Series" description="Multi-part deep-dives on memory management, concurrency, languages, and more.">
  <div class="mx-auto max-w-4xl px-4 pt-12 pb-16 sm:px-6">
    <header class="mb-12">
      <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Blog series</h1>
      <p class="mt-3 text-lg text-[var(--color-fg-muted)]">
        Multi-part series — read in order or jump in.
      </p>
    </header>

    <div class="space-y-12">
      {
        seriesGroups.map(({ series, posts }) => (
          <section>
            <h2 class="font-display text-2xl font-semibold tracking-tight">
              <a href={`/series/${slugifySeries(series)}/`} class="text-[var(--color-fg)] hover:text-[var(--color-accent)]">
                {series}
              </a>
              <span class="ml-2 text-sm font-normal text-[var(--color-fg-subtle)]">· {posts.length} posts</span>
            </h2>
            {meta[series] && (
              <p class="mt-2 text-[var(--color-fg-muted)]">{meta[series]}</p>
            )}
            <ol class="mt-4 space-y-2 text-sm">
              {posts.map((p, i) => (
                <li class="flex items-baseline gap-3">
                  <span class="w-6 shrink-0 text-right text-xs text-[var(--color-fg-subtle)]">{i + 1}.</span>
                  <a href={`/${p.id}/`} class="text-[var(--color-fg)] hover:text-[var(--color-accent)]">
                    {p.data.title}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

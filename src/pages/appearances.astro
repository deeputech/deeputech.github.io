---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { Content as Talks } from "~/data/talks.mdx";
import { Content as TalksPast } from "~/data/talks-past.mdx";
---

<BaseLayout title="Events" description="Upcoming and past speaking engagements by Deepu K Sasidharan.">
  <div class="mx-auto max-w-3xl px-4 pt-12 pb-16 sm:px-6">
    <header class="mb-10">
      <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Events</h1>
      <p class="mt-3 text-lg text-[var(--color-fg-muted)]">
        Conference talks, meetups, and podcasts. See my{" "}
        <a href="https://sessionize.com/deepu-k-sasidharan/" class="underline-offset-2 hover:underline">Sessionize profile</a>{" "}
        for full details, or browse{" "}
        <a href="https://www.youtube.com/playlist?list=PLxayiD7e52nPpb-sSaoOPc-zXGhmOaNHK" class="underline-offset-2 hover:underline">talk recordings on YouTube</a>.
      </p>
    </header>

    <section class="mb-16">
      <h2 class="font-display mb-4 text-xs font-semibold tracking-wider text-[var(--color-fg-subtle)] uppercase">Upcoming</h2>
      <div class="prose-blog">
        <Talks />
      </div>
    </section>

    <section>
      <h2 class="font-display mb-4 text-xs font-semibold tracking-wider text-[var(--color-fg-subtle)] uppercase">Past</h2>
      <div class="prose-blog">
        <TalksPast />
      </div>
    </section>
  </div>
</BaseLayout>
